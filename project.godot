[application]

config/name="Realm of Albedo"
run/main_scene="res://Scenes/Menu.tscn"
config/icon="res://icon.png"

[autoload]

Utilities="*res://Source/Utilities/Utilities.gd"
GameData="*res://Source/Game Managers/GameData.gd"
VehicleFactory="*res://Source/Vehicle Management/VehicleFactory.gd"
PlayerGarage="*res://Source/Vehicle Management/PlayerGarage.gd"

[display]

window/size/width=1366
window/size/height=768
window/size/fullscreen=true
window/dpi/allow_hidpi=true
window/stretch/mode="viewport"
window/stretch/aspect="keep_width"

[input]

